{
	"name": "dsh-workspace-folders",
	"version": "0.1.0",
	"description": "DeepSeek Harness Web GUI plugin: group sidebar workspaces into nested folders with icons, inside the shipped workspace browser",
	"homepage": "https://github.com/yuu1111/dsh-workspace-folders#readme",
	"bugs": {
		"url": "https://github.com/yuu1111/dsh-workspace-folders/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yuu1111/dsh-workspace-folders.git"
	},
	"keywords": [
		"cordis",
		"deepseek-harness",
		"dsh",
		"dsh-plugin",
		"workspace",
		"folder",
		"sidebar",
		"web-ui"
	],
	"license": "MIT",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"author": {
		"name": "yuu1111"
	},
	"type": "module",
	"main": "lib/index.js",
	"exports": {
		".": "./lib/index.js",
		"./client": "./lib/client.js"
	},
	"files": [
		"lib",
		"cordis.patch.yml",
		"README.md",
		"README.ja.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"packageManager": "bun@1.4.2",
	"scripts": {
		"build": "bun build.ts",
		"prepack": "bun run build",
		"check": "tsc -p tsconfig.json",
		"test": "bun run build && bun test",
		"lint": "biome check .",
		"format": "biome check --write --unsafe .",
		"prepare": "bun run build"
	},
	"dsh": {
		"bundle": {
			"patch": "./cordis.patch.yml"
		},
		"client": {
			"platform": "web",
			"inject": [
				"@deepseek-ai/dsh-client-ui-layout",
				"@deepseek-ai/dsh-client-ui-settings",
				"@deepseek-ai/dsh-client-ui-sidebar",
				"@deepseek-ai/dsh-client-ui-workspace"
			]
		}
	},
	"peerDependencies": {
		"@deepseek-ai/cordis": "^4.0.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@deepseek-ai/cordis": "^4.0.5",
		"@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.2",
		"@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2",
		"@types/bun": "^1.4.3",
		"@types/react": "~19.3.0",
		"@types/react-dom": "~19.3.0",
		"@yuu1111/biome-config": "^2.2.4",
		"@yuu1111/knip-config": "^2.1.0",
		"@yuu1111/tsconfig": "^1.0.7",
		"emojibase-data": "18.0.0",
		"knip": "^6.41.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@deepseek-ai/schemastery": "~3.18.5"
	}
}
